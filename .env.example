# Copie para .env e ajuste. Nunca coloque o .env no Git.

# Banco de dados
#   Desenvolvimento (padrão, sem instalar nada): PostgreSQL embutido (PGlite) em ./data/pglite
DATABASE_URL=pglite:./data/pglite
#   Produção: PostgreSQL 15+
# DATABASE_URL=postgres://medai:SENHA@localhost:5432/medai

# Servidor
PORT=4173
HOST=127.0.0.1
# NODE_ENV=production        # em produção: exige DATABASE_URL e ativa cookie Secure
# COOKIE_SECURE=true         # obrigatório atrás de HTTPS
SESSION_DAYS=30
TZ=America/Sao_Paulo         # "hoje" das revisões e das inscrições

# Radar de residências
RADAR_CONTACT=               # e-mail ou URL de contato enviado no User-Agent da coleta (recomendado)
RADAR_UPDATE_INTERVAL_HOURS=0  # >0 atualiza o Radar dentro do servidor (recomendado com PGlite)
RADAR_UPDATE_ON_START=false
# RADAR_AREMG_MAX=           # limita quantos editais da AREMG são lidos (testes)

# Conta local de desenvolvimento (npm run db:seed:dev). Sem histórico.
# DEV_USER_EMAIL=
# DEV_USER_PASSWORD=

# Busca externa: não utilizada nesta versão. Reservado para um provedor futuro (chave só no servidor).
# SEARCH_PROVIDER=
# SEARCH_API_KEY=
